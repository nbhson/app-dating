generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  name             String?
  avatarUrl        String?
  passwordHash     String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastActiveAt     DateTime  @default(now())
  isAdmin          Boolean   @default(false)
  // new fields
  isVerified       Boolean   @default(false)
  verifiedAt       DateTime?
  verificationStatus String @default("NONE") // NONE, PENDING, VERIFIED, REJECTED
  isIncognito      Boolean   @default(false)
  premiumUntil     DateTime?
  stamps           Int       @default(3) // priority letters per week
  stampsResetAt    DateTime?
  height           Int?
  languages        String?   // JSON array
  religion         String?
  wantKids         String?
  smoking          String?   // NEVER, SOCIAL, OFTEN
  drinking         String?

  profile        Profile?
  photos         ProfilePhoto[]
  preferences    Preference?
  likesSent      Like[]    @relation("likesFrom")
  likesReceived  Like[]    @relation("likesTo")
  passesSent     Pass[]    @relation("passesFrom")
  passesReceived Pass[]    @relation("passesTo")
  matchesA       Match[]   @relation("matchA")
  matchesB       Match[]   @relation("matchB")
  blocksSent     Block[]   @relation("blocker")
  blocksReceived Block[]   @relation("blocked")
  reportsSent    Report[]  @relation("reporter")
  reportsReceived Report[] @relation("reported")
  messages       Message[]
  dailyUsage     DailyUsage[]
  promptAnswers  PromptAnswer[]
  dailyAnswers   DailyAnswer[]
  accounts       Account[]
  sessions       Session[]
  favorites      Favorite[] @relation("favoriter")
  favoritedBy    Favorite[] @relation("favorited")
  notifications  Notification[]
  verificationRequests VerificationRequest[]
  adminActions   AdminAction[] @relation("adminActor")
  adminTargets   AdminAction[] @relation("adminTarget")

  @@index([status])
  @@index([lastActiveAt])
  @@index([isVerified])
  @@index([verificationStatus])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  dob        DateTime
  gender     String
  location   String?
  latitude   Float?
  longitude  Float?
  bio        String?
  occupation String?
  education  String?
  interests  String?  // JSON array
  voiceUrl   String?
  voiceDuration Int?  // seconds
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([gender])
  @@index([dob])
  @@index([latitude, longitude])
}

model ProfilePhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  position  Int
  createdAt DateTime @default(now())
  status    String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  moderatedAt DateTime?
  moderatedBy String?

  @@index([userId, position])
}

model Preference {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestedIn String @default("EVERYONE") // MEN WOMEN EVERYONE
  minAge       Int    @default(18)
  maxAge       Int    @default(99)
  maxDistance  Int?
  intent       String @default("UNSURE") // LONG_TERM, SHORT_TERM, FRIENDSHIP, EXPLORING, UNSURE
  // advanced filters
  educationFilter String? // JSON array or single
  hasVoiceOnly Boolean @default(false)
  hasPhotoOnly Boolean @default(false)
  verifiedOnly Boolean @default(false)
}

model Like {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  comment    String?
  promptId   String?
  isPriority Boolean  @default(false)
  createdAt  DateTime @default(now())
  fromUser   User     @relation("likesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("likesTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([isPriority])
}

model Pass {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())
  fromUser   User     @relation("passesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("passesTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  status    String   @default("ACTIVE")
  userA     User     @relation("matchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("matchB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  readAt    DateTime?
  editedAt  DateTime?
  deletedAt DateTime?
  isEdited  Boolean  @default(false)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([senderId])
  @@index([deletedAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  reason     String
  details    String?
  createdAt  DateTime @default(now())
  status     String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  reviewedAt DateTime?
  reviewedBy String?
  actionTaken String?
  resolutionNote String?
  reporter   User     @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User     @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
}

model DailyUsage {
  id             String   @id @default(cuid())
  userId         String
  date           String   // YYYY-MM-DD
  profilesViewed Int      @default(0)
  likes          Int      @default(0)
  passes         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model PromptAnswer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  status    String   @default("APPROVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model DailyQuestion {
  id        String   @id @default(cuid())
  date      String   @unique
  question  String
  createdBy String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DailyAnswer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

// New models

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  targetId  String
  createdAt DateTime @default(now())
  user      User     @relation("favoriter", fields: [userId], references: [id], onDelete: Cascade)
  target    User     @relation("favorited", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
  @@index([userId])
  @@index([targetId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // MATCH, MESSAGE, LIKE, SYSTEM, VERIFICATION
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model AdminAction {
  id        String   @id @default(cuid())
  adminId   String
  targetId  String?
  action    String   // SUSPEND, ACTIVATE, DELETE, VERIFY, REJECT_VERIFY, RESOLVE_REPORT, etc
  reason    String?
  metadata  String?  // JSON
  createdAt DateTime @default(now())
  admin     User     @relation("adminActor", fields: [adminId], references: [id], onDelete: Cascade)
  target    User?    @relation("adminTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model VerificationRequest {
  id        String   @id @default(cuid())
  userId    String
  photoUrl  String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  note      String?
  reviewedBy String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
